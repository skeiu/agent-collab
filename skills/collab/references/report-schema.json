{
  "description": "本文件：执行端汇报的 JSON 结构（PLAN.md §13）。report.mjs 用它校验从回复里提取的汇报；字段变化时更新。",
  "title": "agent-collab 执行端汇报",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "criteria",
    "commands",
    "files_changed",
    "deviations",
    "blocked_checks",
    "open_questions",
    "human_inputs"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "done",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "met",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "met": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "result"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "error"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "handling"
        ],
        "properties": {
          "message": {
            "type": "string"
          },
          "handling": {
            "type": "string"
          }
        }
      }
    }
  }
}
